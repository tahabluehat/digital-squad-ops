# DigitalSquad — Apache / LiteSpeed configuration (public_html)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # IMPORTANT: other applications live in sub-folders of public_html
  # (for example /backup-accounting = Dolibarr ERP). They must keep working.
  # Anything that is a real file or a real directory is served normally and
  # is never handled by this website.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Extra safety: never route these folders through the front controller.
  RewriteRule ^(backup-accounting|cgi-bin|\.well-known)(/|$) - [L]

  # Everything else goes to the front controller,
  # so direct article links and browser refreshes work.
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve hidden or config files.
<FilesMatch "^\.|\.(sql|md|log|ini|sh|example)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
